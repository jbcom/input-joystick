{
  "name": "input-joystick",
  "version": "0.3.0",
  "description": "Touch-anywhere floating virtual joystick for React canvas games, with a pure deadzone/normalize function and an opt-in keyboard co-map.",
  "type": "module",
  "license": "MIT",
  "author": "Jon Bogaty <jon@jonbogaty.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbcom/input-joystick.git"
  },
  "homepage": "https://github.com/jbcom/input-joystick#readme",
  "bugs": {
    "url": "https://github.com/jbcom/input-joystick/issues"
  },
  "keywords": [
    "joystick",
    "virtual-joystick",
    "touch",
    "pointer-events",
    "react",
    "game-dev",
    "mobile",
    "canvas",
    "input"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.10.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:cjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "node scripts/build-cjs.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:docs": "markdownlint-cli2 README.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md CHANGELOG.md AGENTS.md \"docs/**/*.md\" \"!docs/node_modules/**\" \"!docs/dist/**\" .github/PULL_REQUEST_TEMPLATE.md",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "pnpm run test:jsdom && pnpm run test:browser",
    "test:jsdom": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "coverage": "vitest run --config vitest.config.ts --coverage && vitest run --config vitest.browser.config.ts --coverage",
    "package:check": "publint && attw --pack .",
    "smoke:consumer": "node scripts/consumer-smoke.mjs",
    "docs:dev": "pnpm --filter input-joystick-docs dev",
    "docs:build": "pnpm --filter input-joystick-docs build",
    "docs:check": "pnpm --filter input-joystick-docs check",
    "verify": "pnpm run lint && pnpm run lint:docs && pnpm run typecheck && pnpm run coverage && pnpm run build && pnpm run package:check && pnpm run smoke:consumer",
    "prepack": "pnpm run build",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.24.0",
    "playwright": "1.64.1",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "markdownlint-cli2"
    ]
  }
}
